# 複製此檔為 .env 後填入自己的值（.env 已被 .gitignore 排除，不會進 git）

# OpenAlex 免費 API key（2026/2 起需要，至 https://openalex.org 申請）
# 留空時服務仍可啟動，但呼叫 OpenAlex 可能被拒絕
OPENALEX_API_KEY=

# Dify API 基底網址（eval 腳本從 Windows 主機呼叫 Docker 中的 Dify）
DIFY_API_BASE=http://localhost/v1

# Dify Workflow 應用的 API key（在 Dify 應用的「API 存取」頁面取得）
DIFY_WORKFLOW_API_KEY=
